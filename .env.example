# Your Brief - Simple MVP Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Gmail API Configuration
# Download credentials.json from Google Cloud Console and place in project root
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# SendGrid Email Configuration
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=yourbrief@yourdomain.com
SENDGRID_FROM_NAME=Your Brief

# Your Email (where the brief will be sent)
USER_EMAIL=your-email@gmail.com

# Flask Configuration (for web app)
FLASK_SECRET_KEY=generate_random_secret_here
FLASK_ENV=development

# Google OAuth (Centralized - for web app multi-user)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/callback

# Encryption (for storing user tokens)
ENCRYPTION_KEY=generate_with_fernet
